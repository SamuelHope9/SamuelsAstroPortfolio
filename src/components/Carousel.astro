---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";


import VRDrivingSimulators from "../images/VrSimulator.png";
import SideBySideSimulator from "../images/SideBySideSimulator.png";
import GameflowGraph from "../images/GameflowGraph.png";
import HeadsetRoad from "../images/HeadsetRoad.png";
import Quest3 from "../images/Quest3Headset.png";


---



<style>
	@import '../styles/carousel.css';
</style>

<script>

import { slide } from "astro:transitions";
import Swiper from "swiper/bundle";

import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
import 'swiper/swiper-bundle.css';

var swiper = new Swiper('.swiper', {
    effect: 'coverflow',
    grabCursor: true,
    centeredSlides: true,
	loop: true,
    slidesPerView: 3,
    coverflowEffect: {
		scale: 0.9,
		rotate: 60,
        depth: 500,
        modifier: 0.8,
        slideShadows: true,
      },
	  breakpoints: {
      0: { // when window >=0px - webflow mobile portriat
        slidesPerView: 1,
        spaceBetween: -16,
      },
      478: { // when window >= 478px - webflow mobile landscape
        slidesPerView: 2,
        spaceBetween: -16,
      },
      767: { // when window >= 767px - webflow tablet
        slidesPerView: 3,
        spaceBetween: -16,
      },
      988: { // when window >= 988px - webflow desktop
        slidesPerView: 3,
        spaceBetween: -16,
      },
      1920: { // when window >= 988px - webflow desktop
        slidesPerView: 3,
        spaceBetween: -16,
      }
    },

      pagination: {
        el: '.swiper-pagination',
      },
    });

	swiper.slides.forEach(slide => {
 		slide.onclick = () => {
    		swiper.slideToLoop(slide.dataset.swiperSlideIndex)

  		}
	})




	function ActivateLinks(SwiperElement,Activate) {    
        var links = SwiperElement.getElementsByClassName("swiper-link");    
        for (var i = 0; i < links.length; i++) {    
			if(Activate == true)
			{
				links[i].setAttribute("href", links[i].rel); 
			}
			else
			{
				links[i].setAttribute("href", "javascript:void(0)"); 
			}
        }
    } 

	swiper.on('realIndexChange', function () {
		ActivateLinks(swiper.slides[swiper.activeIndex],true);
		//console.log("Test");
		//swiper.clickedSlide.setAttribute("class","ActiveSlide")

		ActivateLinks(swiper.slides[swiper.previousIndex],false);
		//console.log(swiper.realIndex+" Index " + (PreviousRealIndex));

		//PreviousRealIndex = swiper.realIndex;
		//swiper.slides[swiper.previousIndex].setAttribute("class","NONE")
	});

	const urlParams = new URLSearchParams(window.location.search);
	const SlideNumb = urlParams.get('slide');
	const ParsedSlideNumb = parseInt(SlideNumb, 10);

	if(!isNaN(ParsedSlideNumb))
	{
		swiper.slideToLoop(ParsedSlideNumb);
	}

</script>


<div>
<!-- Slider main container -->
<div class="swiper">
	<!-- Additional required wrapper -->
	<div class="swiper-wrapper">
	  <!-- Slides -->
	  	<div class="swiper-slide" data-hash="GameFlow4" id="GameFlow4">
			<a class="swiper-link" href="javascript:void(0)" rel="/posts/VRDrivingSimulator/">
				<div>
			<div class="picture">
				<picture>
					<source media="(max-width: 799px)" srcset={VRDrivingSimulators.src} />
					<source media="(min-width: 800px)" srcset={VRDrivingSimulators.src} />
					<img src={VRDrivingSimulators.src} alt="VR Driving simulators" />
				</picture>
			</div>
			<div class="detail">
				<h3>VR Driving Simulator</h3>
			</div>
			</div>
		</a>
	  	</div>

	  <div class="swiper-slide" data-hash="GameFlow3" id="GameFlow3">
		<a class="swiper-link" href="javascript:void(0)" rel="/posts/SXSMotionPlatform/">
		<div>
		<div class="picture">
			<picture>
				<source media="(max-width: 799px)" srcset={SideBySideSimulator.src} />
				<source media="(min-width: 800px)" srcset={SideBySideSimulator.src} />
				<img src={SideBySideSimulator.src} alt="SideBySideSimulator" />
			</picture>
		</div>
		<div class="detail">
		  <h3>SXS motion platform</h3>
		</div>
	</div>
	</a>
	  </div>


	  <div class="swiper-slide" data-hash="GameFlow2" id="GameFlow2">
		<a class="swiper-link" href="javascript:void(0)" rel="/posts/CoDriVRExplore/">
		<div>
		<div class="picture">
			<source media="(max-width: 799px)" srcset={HeadsetRoad.src} />
			<source media="(min-width: 800px)" srcset={HeadsetRoad.src} />
			<img src={HeadsetRoad.src} alt="VR Driving simulators" />
		</div>
		<div class="detail">
		  <h3>CoDriVr explore</h3>
		</div>
	</div>
		</a>
	  </div>


	  <div class="swiper-slide" data-hash="GameFlow9" id="GameFlow9">
		<a class="swiper-link" href="javascript:void(0)" rel="/posts/RoadSaftey/">
		<div>
		<div class="picture">
			<source media="(max-width: 799px)" srcset={Quest3.src} />
			<source media="(min-width: 800px)" srcset={Quest3.src} />
			<img src={Quest3.src} alt="VR Driving simulators" />
		</div>
		<div class="detail">
		  <h3>Road saftey</h3>
		</div>
		</div>
		</a>
	  </div>

	
	  	<div class="swiper-slide" data-hash="GameFlow" id="GameFlow">

			<a class="swiper-link" href="javascript:void(0)" rel="/posts/GameFlow/">
			<div>
				<div class="picture">
					<source media="(max-width: 799px)" srcset={GameflowGraph.src} />
					<source media="(min-width: 800px)" srcset={GameflowGraph.src} />
					<img src={GameflowGraph.src} alt="VR Driving simulators" />
				</div>
				<div class="detail">
					<h3>Gameflow system</h3>
					<span>c++ </span>
				</div>
	  		</div>
			</a>

		</div>

	</div>

  </div>

</div>

