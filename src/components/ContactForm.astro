---

export const prerender = false; //This will not work without this line due to using api route instead of js

const CaptchaSiteKey = import.meta.env.CAPTCHA_SITE_API_KEY;

---


<style>
  @import '../styles/contactForm.css';
</style>

<div>
  <div id="contact-container">
  <h1 style="text-align: center;">Send me a message!</h1>
  <pre>Got a question or just want to say hello? Go ahead.</pre>
  <form onsubmit="return false" data-message={CaptchaSiteKey}>
    <label>
        Name
        <input type="text" id="name" name="name" />
    </label>
    <label>
        Email
        <input type="email" id="email" name="email" />
    </label>
    <br/>
    <label>
        Message
        <textarea id="message" name="message" />
    </label>

    <button>Send</button >
</form>

<script async  src='https://www.google.com/recaptcha/api.js?render=6Lf8eOcqAAAAAAn76mdOERuhB0hCWPf5KbpgSFzV'></script>
<script>
import { actions } from 'astro:actions';


async function CaptchaCallback(token)
  {
      console.log("GetTheCallBack");
      const formData = new FormData(form);
      formData.append("Test",token);
      await actions.SubmitFormAction(formData);
  };
  
  if(typeof grecaptcha === 'undefined') { grecaptcha = {}; }

  grecaptcha.ready = function(cb){
    if(typeof grecaptcha === 'undefined') {
      // window.__grecaptcha_cfg is a global variable that stores reCAPTCHA's
      // configuration. By default, any functions listed in its 'fns' property
      // are automatically executed when reCAPTCHA loads.
      const c = '___grecaptcha_cfg';
      window[c] = window[c] || {};
      (window[c]['fns'] = window[c]['fns']||[]).push(cb);
    } else {
      cb();
    }
  }


  async function SendCapthca(CaptchaSiteKey)
  {
    grecaptcha.ready(function() {
          console.log("ExecuteCaptha");
          console.log(CaptchaSiteKey);
          grecaptcha.ready(function() {
          grecaptcha.execute(CaptchaSiteKey, {action: 'submit'}).then(function(token) {
              CaptchaCallback(token);
          });
        });
    });
  }

  const form = document.querySelector('form');
 

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    console.log("click1");
    const CaptchaSiteKey = form.dataset.message;

    console.log(CaptchaSiteKey);
    
    SendCapthca(CaptchaSiteKey);
    return false;
  })

</script>



</div>
</div>


