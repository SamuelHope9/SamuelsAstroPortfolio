---
import { actions } from 'astro:actions';

export const prerender = false; //This will not work without this line due to using api route instead of js
const CaptchaSiteKey = import.meta.env.CAPTCHA_SITE_API_KEY;




const result = Astro.getActionResult(actions.SubmitFormAction);
---


<style>
  @import '../styles/contactForm.css';
</style>



<div>
  <div id="contact-container">
    <form onsubmit="return false" data-message={CaptchaSiteKey}>
      <div id="contact-form">
      <h1 style="text-align: center;">Send me a message!</h1>
      <p>Got a question or just want to say hello? Go ahead.</p>
      <div style="float:left; width: 45%;">
        <input style="width: 100%; border-radius: 8px; height:30px" type="text" id="name" name="name" placeholder="your name"/>
      </div>

      <div style="float:right; width: 45%;">
        <input style="width: 100%; border-radius: 8px; height:30px" type="email" id="email" name="email" placeholder="your email"/>
      </div>

      <br/>
      <br/>
      <br/>
      <div >
        <textarea style="width: 100%; height:100px;border-radius: 8px;" id="message" name="message" placeholder="Lorem ipsum"/>
      </div>
    
    </div>
    <div id="email-sent" style="display: none; visibility:hidden;">
      <h1>Message has sent</h1>
      <h2>Thank you for your message i will try to get in touch as soon as possible.</h2>
    </div>
    <div id="email-fail" style="display: none; visibility:hidden;">
      <h1>OOPS looks like sending emails is broken</h1>
    </div>
      <button id="email-button" class="button-unclicked">Submit
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24"><path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"/></svg>
      </button >
    </form>
  </div>
</div>


<script async  src='https://www.google.com/recaptcha/api.js?render=6Lf8eOcqAAAAAAn76mdOERuhB0hCWPf5KbpgSFzV'></script>
<script>
import { actions } from 'astro:actions';

async function CaptchaCallback(token)
  {
      const formData = new FormData(Form);
      formData.append("CaptchaToken",token);
      const { data, error } = await actions.SubmitFormAction(formData);

      const formDiv = document.getElementById("contact-form");
      formDiv.style.display = "none";
      formDiv.style.visibility = "hidden";

      const EmailSentDiv = document.getElementById("email-sent");
      EmailSentDiv.style.display = "inline";
      EmailSentDiv.style.visibility = "visible";

      return;

      if (error) {
        const EmailFailDiv = document.getElementById("email-fail");
        EmailFailDiv.style.display = "inline";
        EmailFailDiv.style.visibility = "visible";
        return;
      }
      else
      {
        const EmailSentDiv = document.getElementById("email-sent");
        EmailSentDiv.style.display = "inline";
        EmailSentDiv.style.visibility = "visible";
      }
  };
  

  //To solve any race conditions with grecaptcha not being loaded yet
  if(typeof grecaptcha === 'undefined') { grecaptcha = {}; }
  grecaptcha.ready = function(cb){
    if(typeof grecaptcha === 'undefined') {
      // window.__grecaptcha_cfg is a global variable that stores reCAPTCHA's
      // configuration. By default, any functions listed in its 'fns' property
      // are automatically executed when reCAPTCHA loads.
      const c = '___grecaptcha_cfg';
      window[c] = window[c] || {};
      (window[c]['fns'] = window[c]['fns']||[]).push(cb);
    } else {
      cb();
    }
  }


  async function SendCapthca(CaptchaSiteKey)
  {
    grecaptcha.ready(function() {
          console.log("ExecuteCaptha");
          console.log(CaptchaSiteKey);
          grecaptcha.ready(function() {
          grecaptcha.execute(CaptchaSiteKey, {action: 'submit'}).then(function(token) {
              console.log("Execute");
              CaptchaCallback(token);
          });
        });
    });
  }
  
  const Form = document.querySelector('form');
  Form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const EmailButton = document.getElementById("email-button");
    EmailButton.classList.add("button-clicked");
    EmailButton.classList.remove("button-unclicked");

    const ContactFormDiv = document.getElementById("contact-form");
    ContactFormDiv.classList.add("animate-out-fade-right");
    
    const captchaSiteKey = Form.dataset.message;
    SendCapthca(captchaSiteKey);
    return false;
  })

</script>





