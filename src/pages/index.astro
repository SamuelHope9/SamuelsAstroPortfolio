---
import BaseLayout from '../Layouts/BaseLayout.astro';

import Page from '../Layouts/Page.astro';

import ExperianceList from '../components/ExperianceList.astro';
import ContactForm from '../components/ContactForm.astro'
import Carousel from '../components/Carousel.astro'
import SkillsList from '../components/SkillsList.astro'

const pageTitle = "Home Page";

import '../styles/homepage.css';
import localLaptopImage from "../images/LaptopTransparent.png";
import localLaptopMobileImage from "../images/LaptopTransparentMobile.png";

if (Astro.request.method === "POST") {
    console.log("Test log");
  }
---



<BaseLayout>
<div class="home-page">

  <Page SectionID="home">
    <div class="side-container">
      <div class="side-left">
        <div class="vertCenter-outer">
          <div class="vertCenter-middle">
            <div class="vertCenter-inner">
              <div class="container">
                <div class="inner-primary"><h1 class="Tittle">Welcome</h1></div>
                <div class="inner-rest"><p class="WelcomeText">My name is Samuel Fisher, I am a programmer based in Dunedin NZ. I currently Specialize in C++ and Unreal Engine.</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="side-right">
        <div class="vertCenter-outer">
          <div class="vertCenter-middle">
          <div class="vertCenter-inner">
          <picture>
            <source media="(max-width: 600px)" srcset={localLaptopMobileImage.src} />
            <source media="(min-width: 600px)" srcset={localLaptopImage.src} />
            <img src={localLaptopImage.src} alt="Laptop with code" />
          </picture>
        </div>
      </div>
        </div>
      </div>
    </div>
  </Page>
  
  <Page SectionID="experiance">
    <div class="desktop">
      <div class="side-container">
        <div class="side-left">
          <ExperianceList/>
        </div>
        <div id="divider"></div>
        <SkillsList/>
      </div>
    </div>
    <div class="mobile">
      <ExperianceList/>
    </div>
  </Page>
  
  <div class="mobile">
    <Page SectionID="skills">
      <SkillsList/>
    </Page>
  </div>


  <Page SectionID="projects">
    <div style="padding-top: 8%;">
        <Carousel />
    </div>
  </Page>


  <Page SectionID="contact">
    <ContactForm/>
  </Page>


  <div class="home-page-nav sbn sbn14">
    <ul class="home-page-nav-list ">
      <li><a id="foo" class="sidebar-bullet is-active" href="#home"></a></li>
      <li><a class="sidebar-bullet" href="#experiance"></a></li>
      <li class="mobile"><a class="sidebar-bullet" href="#skills"></a></li>
      <li><a class="sidebar-bullet" href="#projects"></a></li>
      <li><a class="sidebar-bullet" href="#contact"></a></li>
    </ul>
  </div>

</div>
</BaseLayout>

<script src="../scripts/SidebarBullets.js"></script>

</html>
